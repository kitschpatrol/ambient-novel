{
	"extends": ["@kitschpatrol/typescript-config/svelte", "./.svelte-kit/tsconfig.json"],
	// Path aliases are supposedly handled by https://kit.svelte.dev/docs/configuration#alias
	// But explored adding $app to solve stand-alone tsc errors
	// "compilerOptions": {
	// 	"paths": {
	// 		"$lib": ["./src/lib"],
	// 		"$lib/*": ["./src/lib/*"],
	// 		"$app/*": ["./node_modules/@sveltejs/kit/assets/app/*"]
	// 	}
	// },
	// The generated SvelteKit config's include list replaces the shared one, so restore project-wide coverage for scripts and config files
	"include": ["**/**.*"],
	"exclude": ["**/dist/", "**/bin/", "**/build/"]
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
